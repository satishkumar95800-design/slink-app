# Lets pnpm resolve plain semver ranges (e.g. "*") to local workspace packages
# instead of the npm registry — needed so apps/web-admin's dependency on
# @slink/types and @slink/config (declared as "*", not "workspace:^", so that
# plain `npm install` on a Node host without pnpm/corepack also works) still
# links locally under pnpm.
link-workspace-packages=true
