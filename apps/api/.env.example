# Postgres connection string (Prisma). Local: docker-compose postgres.
# Prod: Supabase project settings -> Database -> Connection string (URI, port 5432 or the pooler on 6543).
DATABASE_URL=
# Optional: connection used only for migrations at boot (must NOT be the
# transaction pooler on 6543). If unset, a Supabase pooler URL on 6543 is
# switched to session mode (5432) automatically. See src/migrations-runner.ts.
# DIRECT_URL=

# Redis, used by the Bull queue (notifications module). Local: docker-compose redis.
REDIS_URL=

# JWT signing secret + token lifetimes for auth module.
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Firebase Admin SDK service account, for Phone OTP verification + FCM push.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Twilio, for SMS notifications.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Encrypts each school's Razorpay key secret and webhook secret in the DB
# (payment-gateway.service.ts). Any random string of 32+ characters, e.g.
# `openssl rand -base64 48`. Keep it safe: changing it makes stored secrets
# unreadable until they are re-entered in the platform console.
PAYMENT_SECRETS_KEY=

# Premium AI features (docs/SPEC-ai.md). Only used for schools with the
# aiInsights module switched on; without any key every AI feature is skipped.
# Sarvam (default when set): notice translation (sarvam-translate:v1) and
# report-remark drafts (sarvam-105b). Anthropic: reading payment-proof
# screenshots (Sarvam's chat API is text-only), and everything else if no
# Sarvam key is set.
SARVAM_API_KEY=
ANTHROPIC_API_KEY=
# Optional: force a provider, per-school monthly token cap (default 2000000)
# and model overrides.
# AI_PROVIDER=sarvam
# AI_MONTHLY_TOKEN_LIMIT=2000000
# SARVAM_MODEL=sarvam-105b
# AI_MODEL_FAST=claude-haiku-5-5
# AI_MODEL_SMART=claude-sonnet-5-5

# AWS credentials. Used for S3 (file uploads) and Rekognition (screening
# homework/notice photos). The IAM user needs the bucket plus
# rekognition:DetectModerationLabels.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Only set for local dev against LocalStack; leave unset in production so the
# AWS SDK talks to real S3 endpoints.
# S3_ENDPOINT=http://localhost:4566

# Photo screening for homework/notice photos: on by default with real S3, off
# with S3_ENDPOINT (LocalStack has no Rekognition). When on and the check
# can't run, the photo is refused.
# IMAGE_MODERATION=on

NODE_ENV=development
# PORT is provided by the host (e.g. Hostinger/Passenger) in production —
# don't hardcode it there. Defaults to 3000 locally if unset.
PORT=3000

API_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
# Comma-separated extra origins allowed for CORS beyond ADMIN_BASE_URL.
EXTRA_CORS_ORIGINS=

# Marketing-site contact form email (Phase 5). Leave blank to only store
# submissions (they show in Platform console → Leads). Hostinger mailbox: smtp.hostinger.com, port 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_NOTIFY_EMAIL=
