generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  parent
  teacher
  admin
  accounts
  super_admin
  developer
}

enum FeeStatus {
  pending
  partial
  paid
  overdue
  waived
}

enum PaymentOrderStatus {
  created
  attempted
  paid
  failed
  refunded
}

enum PaymentGateway {
  razorpay
  stripe
  payu
}

enum ReportStatus {
  draft
  published
}

enum ReportType {
  academic
  attendance
  behavior
  homework
  report_card
}

enum BroadcastKind {
  notice
  homework
}

enum AttendanceStatus {
  present
  absent
  late
  leave
}

enum StudentNoteType {
  note
  mom
  complaint
  parent_discussion
}

enum GuardianRelation {
  father
  mother
  guardian
}

// Prisma enum identifiers can't contain "+"/"-", so the human-facing "A+"/"A-"/...
// strings are translated to/from these identifiers at the API boundary — see
// apps/api/src/common/blood-group.ts. Never expose A_POSITIVE etc. to end users.
enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum Caste {
  General
  OBC
  SC
  ST
  EWS
  Other
}

enum Gender {
  male
  female
  other
}

enum NotificationChannel {
  fcm
  sms
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum ImportStatus {
  pending
  validating
  validated
  processing
  completed
  failed
}

enum PaymentMethod {
  cash
  cheque
  bank_transfer
  demand_draft
  gateway
}

// How a FeeItem's annual amount is split into StudentFeeComponent periods.
enum BillingFrequency {
  one_time
  monthly
  quarterly
}

enum ClaimPaymentMode {
  cash
  cheque
  bank_transfer
  upi
}

enum PaymentClaimStatus {
  pending
  approved
  rejected
}

enum DiscountKind {
  percentage
  fixed_amount
  full_waiver
}

enum CustomFieldType {
  text
  number
  dropdown
}

// ─── Tenant ──────────────────────────────────────────────────────────────────

model Tenant {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String   @unique
  name               String
  logoUrl            String?  @map("logo_url")
  backgroundImageUrl String?  @map("background_image_url")
  primaryColor       String   @default("#1E40AF") @map("primary_color")
  accentColor        String   @default("#F59E0B") @map("accent_color")
  timezone           String   @default("Asia/Kolkata")
  isActive           Boolean  @default(true) @map("is_active")
  // What this school calls a "Class" — Class / Grade / Standard / Group / Section / custom.
  classLabel         String   @default("Class") @map("class_label")
  // branding: { coverPhotoUrls, address, contactPhone, contactEmail, websiteUrl, ... }
  branding           Json     @default("{}")
  // features: { installmentPlans, inAppMessaging, transportFeeModule, photoGallery }
  features           Json     @default("{\"installmentPlans\":false,\"inAppMessaging\":false,\"transportFeeModule\":true,\"photoGallery\":false}")
  receiptSequence    Int      @default(0) @map("receipt_sequence")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  users                    User[]
  students                 Student[]
  classes                  Class[]
  feeStructures            FeeStructure[]
  studentFees              StudentFee[]
  paymentOrders            PaymentOrder[]
  transactions             PaymentTransaction[]
  reports                  Report[]
  notifications            Notification[]
  receipts                 Receipt[]
  discountTypes            DiscountType[]
  studentDiscounts         StudentDiscount[]
  customFieldDefinitions   CustomFieldDefinition[]
  studentCustomFieldValues StudentCustomFieldValue[]
  transportSlabs           TransportSlab[]
  subjects                 Subject[]
  teacherSubjects          TeacherSubject[]
  documentCategories       DocumentCategory[]
  accountantDocuments      AccountantDocument[]
  timetableSlots           TimetableSlot[]
  paymentClaims            PaymentClaim[]
  studentNotes             StudentNote[]
  attendanceRecords        AttendanceRecord[]
  schoolHolidays           SchoolHoliday[]
  broadcasts               Broadcast[]
  periodTimings            PeriodTiming[]

  @@map("tenants")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  phone        String?
  email        String?
  name         String
  role         Role
  profession   String?
  passwordHash String?  @map("password_hash")
  fcmTokens    String[] @default([]) @map("fcm_tokens")
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  linkedStudents   StudentParent[]
  reports          Report[]        @relation("TeacherReports")
  refreshTokens    RefreshToken[]
  notifications    Notification[]
  recordedReceipts Receipt[]       @relation("ReceiptRecordedBy")
  taughtClasses    ClassTeacher[]
  taughtSubjects   TeacherSubject[]
  timetableSlots   TimetableSlot[]
  submittedClaims  PaymentClaim[]  @relation("PaymentClaimSubmitter")
  reviewedClaims   PaymentClaim[]  @relation("PaymentClaimReviewer")
  markedAttendance AttendanceRecord[] @relation("AttendanceMarkedBy")
  sentBroadcasts   Broadcast[]        @relation("BroadcastSender")
  authoredStudentNotes StudentNote[]

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([phone])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  deviceId  String?   @map("device_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Student ──────────────────────────────────────────────────────────────────

model Student {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  name            String
  admissionNo     String      @map("admission_no")
  // Optional class roll number; attendance lists sort by it, then name.
  rollNo          String?     @map("roll_no")
  dob             DateTime?   @db.Date
  gender          Gender?
  bloodGroup      BloodGroup? @map("blood_group")
  caste           Caste?
  photoUrl        String?     @map("photo_url")
  classId         String      @map("class_id") @db.Uuid
  transportSlabId String?     @map("transport_slab_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class             Class                     @relation(fields: [classId], references: [id])
  transportSlab     TransportSlab?            @relation(fields: [transportSlabId], references: [id])
  parents           StudentParent[]
  fees              StudentFee[]
  reports           Report[]
  receipts          Receipt[]
  discounts         StudentDiscount[]
  customFieldValues StudentCustomFieldValue[]
  paymentClaims     PaymentClaim[]
  notes             StudentNote[]
  attendance        AttendanceRecord[]

  @@unique([tenantId, admissionNo])
  @@index([tenantId])
  @@index([classId])
  @@map("students")
}

model StudentParent {
  studentId String           @map("student_id") @db.Uuid
  parentId  String           @map("parent_id") @db.Uuid
  relation  GuardianRelation @default(guardian)
  isPrimary Boolean          @default(false) @map("is_primary")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  User    @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
  @@index([parentId])
  @@map("student_parents")
}

// ─── Class ────────────────────────────────────────────────────────────────────

model Class {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  section      String?
  academicYear String   @map("academic_year")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students           Student[]
  teachers           ClassTeacher[]
  subjectAssignments TeacherSubject[]
  feeStructureLinks  FeeStructureClass[]
  reports            Report[]
  receipts           Receipt[]
  timetableSlots     TimetableSlot[]
  attendanceRecords  AttendanceRecord[]
  broadcasts         Broadcast[]

  @@unique([tenantId, name, section, academicYear])
  @@index([tenantId])
  @@map("classes")
}

// Many-to-many: a class can have co-teachers, a teacher can teach several classes.
// isClassTeacher distinguishes the class's homeroom/in-charge teacher (who may
// broadcast text notices to the whole class) from a co-/subject-teacher who only
// gained access to the class via a TeacherSubject assignment (homework-only).
model ClassTeacher {
  classId        String  @map("class_id") @db.Uuid
  teacherId      String  @map("teacher_id") @db.Uuid
  isClassTeacher Boolean @default(false) @map("is_class_teacher")

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([classId, teacherId])
  @@index([teacherId])
  @@map("class_teachers")
}

// ─── Subjects ─────────────────────────────────────────────────────────────────

model Subject {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherSubject[]
  timetableSlots     TimetableSlot[]
  broadcasts         Broadcast[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("subjects")
}

// A teacher teaches a subject in a class. Creating this row also upserts a
// ClassTeacher row (see TeachersService) so the teacher gains broadcast access to
// the class without being flagged as its class teacher.
model TeacherSubject {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, classId])
  @@index([teacherId])
  @@index([classId])
  @@map("teacher_subjects")
}

// ─── Timetable (Addendum 4 / A10) ──────────────────────────────────────────────

// One period, one class, one day — the admin-managed weekly grid a teacher's
// dashboard reads from. dayOfWeek: 1=Monday .. 6=Saturday.
model TimetableSlot {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  teacherId    String   @map("teacher_id") @db.Uuid
  classId      String   @map("class_id") @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  dayOfWeek    Int      @map("day_of_week")
  periodNumber Int      @map("period_number")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([tenantId, classId, dayOfWeek, periodNumber])
  @@index([tenantId, teacherId])
  @@index([tenantId, classId])
  @@map("timetable_slots")
}

// ─── Fees ─────────────────────────────────────────────────────────────────────

model FeeStructure {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  dueDate       DateTime @map("due_date") @db.Date
  lateFeePerDay Decimal  @default(0) @map("late_fee_per_day") @db.Decimal(8, 2)
  academicYear  String   @map("academic_year")
  // System-generated plans (e.g. the per-tenant "Previous Year Dues" arrears plan
  // created by the year-end rollover) are hidden from the normal fee-plan UI/list.
  isSystem      Boolean  @default(false) @map("is_system")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes     FeeStructureClass[]
  items       FeeItem[]
  studentFees StudentFee[]

  @@unique([tenantId, name, academicYear])
  @@index([tenantId])
  @@map("fee_structures")
}

// Many-to-many: one fee plan can span multiple classes/groups (e.g. an AS/A-Level
// plan spanning Groups 11 & 12), and a class can be covered by more than one plan.
model FeeStructureClass {
  feeStructureId String @map("fee_structure_id") @db.Uuid
  classId        String @map("class_id") @db.Uuid

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([feeStructureId, classId])
  @@index([classId])
  @@map("fee_structure_classes")
}

model FeeItem {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feeStructureId     String           @map("fee_structure_id") @db.Uuid
  label              String
  amount             Decimal          @db.Decimal(12, 2)
  billingFrequency   BillingFrequency @default(one_time) @map("billing_frequency")
  // Only meaningful when billingFrequency = quarterly — number of months each
  // quarter spans, e.g. [3,3,2,2]. Quarters are weighted by these counts rather
  // than split evenly, since real school terms are uneven.
  quarterMonthCounts Int[]            @default([]) @map("quarter_month_counts")
  // Marks the plan's transport/van fee component — when a student has a
  // TransportSlab assigned, its monthlyAmount overrides this item's manually
  // entered amount for that student.
  isTransportFee     Boolean          @default(false) @map("is_transport_fee")

  feeStructure         FeeStructure          @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  studentFeeComponents StudentFeeComponent[]
  studentDiscounts     StudentDiscount[]

  @@map("fee_items")
}

model StudentFee {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  feeStructureId String    @map("fee_structure_id") @db.Uuid
  amountDue      Decimal   @map("amount_due") @db.Decimal(12, 2)
  amountPaid     Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status         FeeStatus @default(pending)
  dueDate        DateTime  @map("due_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure          @relation(fields: [feeStructureId], references: [id])
  orders       PaymentOrder[]
  receipts     Receipt[]
  components   StudentFeeComponent[]
  paymentClaims PaymentClaim[]

  @@unique([studentId, feeStructureId])
  @@index([tenantId])
  @@index([studentId])
  @@map("student_fees")
}

// The per-component, per-period ledger row exploded from a FeeItem's
// billingFrequency when a StudentFee is assigned (1 row for one_time, 12 for
// monthly, N for quarterly). This is what gives an always-current running
// balance per fee component instead of one lump amount per plan.
model StudentFeeComponent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentFeeId String    @map("student_fee_id") @db.Uuid
  feeItemId    String    @map("fee_item_id") @db.Uuid
  // e.g. "2026-06" for a monthly period, or "Q1" for a quarterly one, "Full Year" for one_time
  periodLabel  String    @map("period_label")
  periodStart  DateTime  @map("period_start") @db.Date
  periodEnd    DateTime  @map("period_end") @db.Date
  dueDate      DateTime  @map("due_date") @db.Date
  amountDue    Decimal   @map("amount_due") @db.Decimal(12, 2)
  amountPaid   Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status       FeeStatus @default(pending)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  studentFee  StudentFee          @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  feeItem     FeeItem             @relation(fields: [feeItemId], references: [id])
  allocations ReceiptAllocation[]

  @@unique([studentFeeId, feeItemId, periodLabel])
  @@index([studentFeeId])
  @@map("student_fee_components")
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model PaymentOrder {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  studentFeeId   String             @map("student_fee_id") @db.Uuid
  gateway        PaymentGateway     @default(razorpay)
  gatewayOrderId String             @map("gateway_order_id")
  amount         Decimal            @db.Decimal(12, 2)
  currency       String             @default("INR")
  status         PaymentOrderStatus @default(created)
  idempotencyKey String             @unique @map("idempotency_key")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentFee  StudentFee          @relation(fields: [studentFeeId], references: [id])
  transaction PaymentTransaction?

  @@index([tenantId])
  @@index([gatewayOrderId])
  @@map("payment_orders")
}

model PaymentTransaction {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  paymentOrderId   String   @unique @map("payment_order_id") @db.Uuid
  gatewayPaymentId String   @map("gateway_payment_id")
  gatewaySignature String?  @map("gateway_signature")
  amount           Decimal  @db.Decimal(12, 2)
  paidAt           DateTime @map("paid_at")
  receiptUrl       String?  @map("receipt_url")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id])

  @@index([tenantId])
  @@map("payment_transactions")
}

// ─── Receipts ─────────────────────────────────────────────────────────────────
// One row per payment (online or offline) — the source of "paid fee history" and
// the printable cash/cheque/bank-transfer receipt. studentId/classId are
// denormalized to capture the class the student was in at time of payment, since
// Student.classId can change later (e.g. promotion/transfer).

model Receipt {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  receiptNumber  String        @map("receipt_number")
  studentFeeId   String        @map("student_fee_id") @db.Uuid
  studentId      String        @map("student_id") @db.Uuid
  classId        String        @map("class_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  reference      String?
  paidOn         DateTime      @map("paid_on") @db.Date
  notes          String?
  recordedBy     String?       @map("recorded_by") @db.Uuid
  paymentOrderId String?       @unique @map("payment_order_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")

  // Addendum 4 / A8 — optional discount/concession label on the transaction.
  // Record-keeping only: does not itself alter amountDue/amountPaid.
  discountTypeId String?  @map("discount_type_id") @db.Uuid
  discountAmount Decimal? @map("discount_amount") @db.Decimal(12, 2)
  discountNote   String?  @map("discount_note")

  // Addendum 4 / A9 — generated receipt PDF + delivery tracking.
  pdfKey             String?   @map("pdf_key")
  pdfGeneratedAt     DateTime? @map("pdf_generated_at")
  receiptDeliveredAt DateTime? @map("receipt_delivered_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentFee     StudentFee          @relation(fields: [studentFeeId], references: [id])
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class          Class               @relation(fields: [classId], references: [id])
  recordedByUser User?               @relation("ReceiptRecordedBy", fields: [recordedBy], references: [id])
  discountType   DiscountType?       @relation(fields: [discountTypeId], references: [id])
  allocations    ReceiptAllocation[]
  paymentClaim   PaymentClaim?

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, paidOn])
  @@index([studentId])
  @@index([classId])
  @@map("receipts")
}

// Lets one receipt cover multiple fee components in a single transaction
// (e.g. Poorna's "Tuition & Van Fee" combined cash receipts). The parent
// Receipt.amount remains the total; these rows are how much of it went to
// which StudentFeeComponent.
model ReceiptAllocation {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId             String  @map("receipt_id") @db.Uuid
  studentFeeComponentId String  @map("student_fee_component_id") @db.Uuid
  amount                Decimal @db.Decimal(12, 2)

  receipt             Receipt             @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  studentFeeComponent StudentFeeComponent @relation(fields: [studentFeeComponentId], references: [id])

  @@index([receiptId])
  @@index([studentFeeComponentId])
  @@map("receipt_allocations")
}

// ─── Payment Claims (Addendum 4 / A12) ─────────────────────────────────────────

// A parent's self-reported "I already paid this elsewhere" submission. Never
// written straight to Receipt/StudentFee — kept as its own pending record
// until an accountant/admin approves it, so an unverified claim can never look
// identical to a verified, staff-recorded payment on the official fee ledger.
model PaymentClaim {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  studentId     String             @map("student_id") @db.Uuid
  studentFeeId  String             @map("student_fee_id") @db.Uuid
  submittedBy   String             @map("submitted_by") @db.Uuid
  fileKey       String             @map("file_key")
  claimedAmount Decimal?           @map("claimed_amount") @db.Decimal(12, 2)
  claimedDate   DateTime?          @map("claimed_date") @db.Date
  claimedMode   ClaimPaymentMode?  @map("claimed_mode")
  note          String?
  status        PaymentClaimStatus @default(pending)
  reviewedBy    String?            @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?          @map("reviewed_at")
  reviewNote    String?            @map("review_note")
  // Receipt recorded when the claim was approved. Null for pending/rejected claims
  // and for claims approved before this column existed.
  receiptId     String?            @unique @map("receipt_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  submitter  User       @relation("PaymentClaimSubmitter", fields: [submittedBy], references: [id], onDelete: Cascade)
  reviewer   User?      @relation("PaymentClaimReviewer", fields: [reviewedBy], references: [id])
  receipt    Receipt?   @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([studentFeeId])
  @@index([status])
  @@map("payment_claims")
}

// ─── Reports ──────────────────────────────────────────────────────────────────

model Report {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  studentId    String       @map("student_id") @db.Uuid
  classId      String       @map("class_id") @db.Uuid
  teacherId    String       @map("teacher_id") @db.Uuid
  type         ReportType   @default(academic)
  term         String
  academicYear String       @map("academic_year")
  content      Json
  pdfKey       String?      @map("pdf_key")
  status       ReportStatus @default(draft)
  publishedAt  DateTime?    @map("published_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class               @relation(fields: [classId], references: [id])
  teacher      User                @relation("TeacherReports", fields: [teacherId], references: [id])
  readReceipts ReportReadReceipt[]

  @@index([tenantId])
  @@index([studentId])
  @@index([teacherId])
  @@map("reports")
}

model ReportReadReceipt {
  reportId String   @map("report_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  readAt   DateTime @default(now()) @map("read_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@id([reportId, userId])
  @@map("report_read_receipts")
}

// ─── Student Notes ────────────────────────────────────────────────────────────
// A private running log a teacher (scoped to their own classes) or
// admin/super_admin can add about one student — free-text notes, minutes of
// meeting, complaints, or "discussion with parent" entries. Deliberately a
// separate model from Report (the *parent-visible* progress report) — these
// rows must never be exposed to a parent or accounts role.
model StudentNote {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  studentId String          @map("student_id") @db.Uuid
  authorId  String          @map("author_id") @db.Uuid
  type      StudentNoteType @default(note)
  content   String          @db.Text
  createdAt DateTime        @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@map("student_notes")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel
  title     String?
  body      String
  data      Json?
  status    NotificationStatus  @default(pending)
  error     String?
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")
  // Set for notice/homework fan-out rows; seenAt is when this parent opened the item.
  broadcastId String?   @map("broadcast_id") @db.Uuid
  seenAt      DateTime? @map("seen_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcast Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([broadcastId])
  @@map("notifications")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  diff       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─── Discounts / Concessions ──────────────────────────────────────────────────

// Per-tenant catalog of discount types (Sibling Discount, Concession, Full
// Waiver, a named sponsor, ...) — names/kinds vary school to school.
model DiscountType {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  name      String
  kind      DiscountKind
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments StudentDiscount[]
  receipts    Receipt[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("discount_types")
}

// A discount tagged onto a student, applied automatically when their
// StudentFeeComponent rows are generated. feeItemId null = applies pro-rata
// across every component on the plan; set = scoped to one component.
model StudentDiscount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  discountTypeId String   @map("discount_type_id") @db.Uuid
  feeItemId      String?  @map("fee_item_id") @db.Uuid
  percentage     Decimal? @db.Decimal(5, 2)
  fixedAmount    Decimal? @map("fixed_amount") @db.Decimal(12, 2)
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  discountType DiscountType @relation(fields: [discountTypeId], references: [id])
  feeItem      FeeItem?     @relation(fields: [feeItemId], references: [id])

  @@index([tenantId])
  @@index([studentId])
  @@map("student_discounts")
}

// ─── Custom Student Fields ────────────────────────────────────────────────────

// Admin-defined extra student fields (e.g. Karnataka's "SATS No", a
// religion/mother-tongue "Category") — schema stays universal, schools
// configure what they specifically need to capture.
model CustomFieldDefinition {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  label       String
  fieldType   CustomFieldType @map("field_type")
  // Choices for fieldType = dropdown, e.g. ["Hindu/Kannada", "Christian/English", ...]
  options     Json?
  // Sensitive fields are restricted to admin/super_admin view and excluded from exports.
  isSensitive Boolean         @default(false) @map("is_sensitive")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values StudentCustomFieldValue[]

  @@unique([tenantId, label])
  @@index([tenantId])
  @@map("custom_field_definitions")
}

model StudentCustomFieldValue {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  studentId         String   @map("student_id") @db.Uuid
  fieldDefinitionId String   @map("field_definition_id") @db.Uuid
  value             String
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student         Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fieldDefinition CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([studentId, fieldDefinitionId])
  @@index([tenantId])
  @@map("student_custom_field_values")
}

// ─── Transport ────────────────────────────────────────────────────────────────

// Distance-range → monthly amount, per tenant. Gated by the existing
// Tenant.features.transportFeeModule flag.
model TransportSlab {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  minDistanceKm Decimal  @map("min_distance_km") @db.Decimal(6, 2)
  maxDistanceKm Decimal  @map("max_distance_km") @db.Decimal(6, 2)
  monthlyAmount Decimal  @map("monthly_amount") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students Student[]

  @@index([tenantId])
  @@map("transport_slabs")
}

// ─── Bulk Import ──────────────────────────────────────────────────────────────

model ImportJob {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  initiatedBy String       @map("initiated_by") @db.Uuid
  fileName    String       @map("file_name")
  status      ImportStatus @default(pending)
  summary     Json?
  errorReport Json?        @map("error_report")
  createdAt   DateTime     @default(now()) @map("created_at")
  completedAt DateTime?    @map("completed_at")

  @@index([tenantId])
  @@map("import_jobs")
}

// ─── Accountant Documents (Addendum 4 / A13) ──────────────────────────────────

// Per-tenant catalog of document categories ("Bank Statement", "Reconciliation
// Sheet", "Cheque Scan", ...) — mirrors DiscountType's admin-configurable-list pattern.
model DocumentCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents AccountantDocument[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("document_categories")
}

// General-purpose working storage for the accounts team's own supporting
// documents — intentionally simple storage/retrieval, no auto-processing.
model AccountantDocument {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  uploadedBy String   @map("uploaded_by") @db.Uuid
  fileKey    String   @map("file_key")
  categoryId String   @map("category_id") @db.Uuid
  note       String?
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category DocumentCategory @relation(fields: [categoryId], references: [id])

  @@index([tenantId])
  @@index([categoryId])
  @@map("accountant_documents")
}

/// Daily attendance: one row per student per school day (docs/SPEC-improvements.md §2.1).
model AttendanceRecord {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  classId          String           @map("class_id") @db.Uuid
  studentId        String           @map("student_id") @db.Uuid
  date             DateTime         @db.Date
  status           AttendanceStatus
  markedBy         String           @map("marked_by") @db.Uuid
  markedAt         DateTime         @default(now()) @map("marked_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  note             String?
  // Whether parents currently hold an "absent" push for this day; drives
  // once-per-day alerts and the correction push when changed back.
  absenceAlertSent Boolean          @default(false) @map("absence_alert_sent")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marker  User    @relation("AttendanceMarkedBy", fields: [markedBy], references: [id])

  @@unique([tenantId, studentId, date])
  @@index([tenantId, classId, date])
  @@map("attendance_records")
}

/// Days excluded from attendance (no marking expected, not counted as unmarked).
model SchoolHoliday {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@map("school_holidays")
}

/// One notice or homework message as sent (docs/SPEC-improvements.md §4.3);
/// each recipient's Notification row links back here for "seen by" counts.
model Broadcast {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  senderId    String        @map("sender_id") @db.Uuid
  classId     String?       @map("class_id") @db.Uuid
  subjectId   String?       @map("subject_id") @db.Uuid
  kind        BroadcastKind
  title       String?
  body        String
  /// [{ key, contentType }] — up to 3 images, or 1 PDF (notices only).
  attachments Json          @default("[]")
  createdAt   DateTime      @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sender        User           @relation("BroadcastSender", fields: [senderId], references: [id], onDelete: Cascade)
  class         Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([tenantId, senderId])
  @@index([tenantId, classId])
  @@map("broadcasts")
}

/// The school's bell schedule: start/end of each period number, for the teacher "Now / Next" strip.
model PeriodTiming {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  periodNumber Int      @map("period_number")
  /// "HH:MM", 24-hour, in the school's timezone.
  startTime    String   @map("start_time")
  endTime      String   @map("end_time")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodNumber])
  @@map("period_timings")
}
