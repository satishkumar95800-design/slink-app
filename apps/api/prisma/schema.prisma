generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  parent
  teacher
  admin
  accounts
  super_admin
}

enum FeeStatus {
  pending
  partial
  paid
  overdue
  waived
}

enum PaymentOrderStatus {
  created
  attempted
  paid
  failed
  refunded
}

enum PaymentGateway {
  razorpay
  stripe
  payu
}

enum ReportStatus {
  draft
  published
}

enum ReportType {
  academic
  attendance
  behavior
  homework
}

enum GuardianRelation {
  father
  mother
  guardian
}

enum NotificationChannel {
  fcm
  sms
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum ImportStatus {
  pending
  validating
  validated
  processing
  completed
  failed
}

// ─── Tenant ──────────────────────────────────────────────────────────────────

model Tenant {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String   @unique
  name         String
  logoUrl      String?  @map("logo_url")
  primaryColor String   @default("#1E40AF") @map("primary_color")
  accentColor  String   @default("#F59E0B") @map("accent_color")
  timezone     String   @default("Asia/Kolkata")
  isActive     Boolean  @default(true) @map("is_active")
  // branding: { coverPhotoUrls, address, contactPhone, contactEmail, websiteUrl, ... }
  branding     Json     @default("{}")
  // features: { installmentPlans, inAppMessaging, transportFeeModule, photoGallery }
  features     Json     @default("{\"installmentPlans\":false,\"inAppMessaging\":false,\"transportFeeModule\":true,\"photoGallery\":false}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users         User[]
  students      Student[]
  classes       Class[]
  feeStructures FeeStructure[]
  studentFees   StudentFee[]
  paymentOrders PaymentOrder[]
  transactions  PaymentTransaction[]
  reports       Report[]
  notifications Notification[]

  @@map("tenants")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  phone      String?
  email      String?
  name       String
  role       Role
  passwordHash String?  @map("password_hash")
  fcmTokens    String[] @default([]) @map("fcm_tokens")
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  linkedStudents StudentParent[]
  reports        Report[]        @relation("TeacherReports")
  refreshTokens  RefreshToken[]
  notifications  Notification[]

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([phone])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  deviceId  String?   @map("device_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Student ──────────────────────────────────────────────────────────────────

model Student {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  admissionNo String    @map("admission_no")
  dob         DateTime? @db.Date
  classId     String    @map("class_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class    Class           @relation(fields: [classId], references: [id])
  parents  StudentParent[]
  fees     StudentFee[]
  reports  Report[]

  @@unique([tenantId, admissionNo])
  @@index([tenantId])
  @@index([classId])
  @@map("students")
}

model StudentParent {
  studentId String           @map("student_id") @db.Uuid
  parentId  String           @map("parent_id") @db.Uuid
  relation  GuardianRelation @default(guardian)
  isPrimary Boolean          @default(false) @map("is_primary")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  User    @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
  @@index([parentId])
  @@map("student_parents")
}

// ─── Class ────────────────────────────────────────────────────────────────────

model Class {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  section      String?
  academicYear String   @map("academic_year")
  teacherId    String?  @map("teacher_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students      Student[]
  feeStructures FeeStructure[]
  reports       Report[]

  @@unique([tenantId, name, section, academicYear])
  @@index([tenantId])
  @@map("classes")
}

// ─── Fees ─────────────────────────────────────────────────────────────────────

model FeeStructure {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  classId       String   @map("class_id") @db.Uuid
  name          String
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  dueDate       DateTime @db.Date @map("due_date")
  lateFeePerDay Decimal  @default(0) @map("late_fee_per_day") @db.Decimal(8, 2)
  academicYear  String   @map("academic_year")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class       Class        @relation(fields: [classId], references: [id])
  items       FeeItem[]
  studentFees StudentFee[]

  @@unique([tenantId, classId, name, academicYear])
  @@index([tenantId])
  @@map("fee_structures")
}

model FeeItem {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feeStructureId String  @map("fee_structure_id") @db.Uuid
  label          String
  amount         Decimal @db.Decimal(12, 2)

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@map("fee_items")
}

model StudentFee {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  feeStructureId String    @map("fee_structure_id") @db.Uuid
  amountDue      Decimal   @map("amount_due") @db.Decimal(12, 2)
  amountPaid     Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status         FeeStatus @default(pending)
  dueDate        DateTime  @db.Date @map("due_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure   @relation(fields: [feeStructureId], references: [id])
  orders       PaymentOrder[]

  @@unique([studentId, feeStructureId])
  @@index([tenantId])
  @@index([studentId])
  @@map("student_fees")
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model PaymentOrder {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  studentFeeId   String             @map("student_fee_id") @db.Uuid
  gateway        PaymentGateway     @default(razorpay)
  gatewayOrderId String             @map("gateway_order_id")
  amount         Decimal            @db.Decimal(12, 2)
  currency       String             @default("INR")
  status         PaymentOrderStatus @default(created)
  idempotencyKey String             @unique @map("idempotency_key")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentFee  StudentFee          @relation(fields: [studentFeeId], references: [id])
  transaction PaymentTransaction?

  @@index([tenantId])
  @@index([gatewayOrderId])
  @@map("payment_orders")
}

model PaymentTransaction {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  paymentOrderId   String   @unique @map("payment_order_id") @db.Uuid
  gatewayPaymentId String   @map("gateway_payment_id")
  gatewaySignature String?  @map("gateway_signature")
  amount           Decimal  @db.Decimal(12, 2)
  paidAt           DateTime @map("paid_at")
  receiptUrl       String?  @map("receipt_url")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id])

  @@index([tenantId])
  @@map("payment_transactions")
}

// ─── Reports ──────────────────────────────────────────────────────────────────

model Report {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  studentId    String       @map("student_id") @db.Uuid
  classId      String       @map("class_id") @db.Uuid
  teacherId    String       @map("teacher_id") @db.Uuid
  type         ReportType   @default(academic)
  term         String
  academicYear String       @map("academic_year")
  content      Json
  pdfKey       String?      @map("pdf_key")
  status       ReportStatus @default(draft)
  publishedAt  DateTime?    @map("published_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class               @relation(fields: [classId], references: [id])
  teacher      User                @relation("TeacherReports", fields: [teacherId], references: [id])
  readReceipts ReportReadReceipt[]

  @@index([tenantId])
  @@index([studentId])
  @@index([teacherId])
  @@map("reports")
}

model ReportReadReceipt {
  reportId String   @map("report_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  readAt   DateTime @default(now()) @map("read_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@id([reportId, userId])
  @@map("report_read_receipts")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel
  title     String?
  body      String
  data      Json?
  status    NotificationStatus  @default(pending)
  error     String?
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@map("notifications")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  diff       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─── Bulk Import ──────────────────────────────────────────────────────────────

model ImportJob {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  initiatedBy String       @map("initiated_by") @db.Uuid
  fileName    String       @map("file_name")
  status      ImportStatus @default(pending)
  summary     Json?
  errorReport Json?        @map("error_report")
  createdAt   DateTime     @default(now()) @map("created_at")
  completedAt DateTime?    @map("completed_at")

  @@index([tenantId])
  @@map("import_jobs")
}
