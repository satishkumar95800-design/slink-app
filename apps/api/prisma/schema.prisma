generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  parent
  teacher
  admin
  accounts
  super_admin
  developer
  /// Head office of a group of schools: read-only view of its branches (docs/SPEC-subscriptions.md 6).
  head_office
  /// School bus driver (mobile app, phone OTP): shares GPS during a trip. Only routes naming it.
  driver
  /// Library desk (console): books, issue and return. Only routes naming it.
  librarian
  /// Front desk (console): enquiries, follow-ups, visitors, calls. Only routes naming it.
  receptionist
}

enum FeeStatus {
  pending
  partial
  paid
  overdue
  waived
}

enum PaymentOrderStatus {
  created
  attempted
  paid
  failed
  refunded
}

enum PaymentGateway {
  razorpay
  stripe
  payu
}

enum ReportStatus {
  draft
  published
}

enum ReportType {
  academic
  attendance
  behavior
  homework
  report_card
}

enum BroadcastKind {
  notice
  homework
}

enum AttendanceStatus {
  present
  absent
  late
  leave
}

enum StudentNoteType {
  note
  mom
  complaint
  parent_discussion
}

enum GuardianRelation {
  father
  mother
  guardian
}

// Prisma enum identifiers can't contain "+"/"-", so the human-facing "A+"/"A-"/...
// strings are translated to/from these identifiers at the API boundary — see
// apps/api/src/common/blood-group.ts. Never expose A_POSITIVE etc. to end users.
enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum Caste {
  General
  OBC
  SC
  ST
  EWS
  Other
}

enum Gender {
  male
  female
  other
}

enum NotificationChannel {
  fcm
  sms
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum ImportStatus {
  pending
  validating
  validated
  processing
  completed
  failed
}

enum PaymentMethod {
  cash
  cheque
  bank_transfer
  demand_draft
  gateway
}

// How a FeeItem's annual amount is split into StudentFeeComponent periods.
enum BillingFrequency {
  one_time
  monthly
  quarterly
}

enum ClaimPaymentMode {
  cash
  cheque
  bank_transfer
  upi
}

enum PaymentClaimStatus {
  pending
  approved
  rejected
}

enum DiscountKind {
  percentage
  fixed_amount
  full_waiver
}

enum CustomFieldType {
  text
  number
  dropdown
}

// ─── Tenant ──────────────────────────────────────────────────────────────────

model Tenant {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String   @unique
  name               String
  logoUrl            String?  @map("logo_url")
  backgroundImageUrl String?  @map("background_image_url")
  primaryColor       String   @default("#1E40AF") @map("primary_color")
  accentColor        String   @default("#F59E0B") @map("accent_color")
  timezone           String   @default("Asia/Kolkata")
  isActive           Boolean  @default(true) @map("is_active")
  // What this school calls a "Class" — Class / Grade / Standard / Group / Section / custom.
  classLabel         String   @default("Class") @map("class_label")
  // Language for users who haven't picked one (en | kn | hi — see common/i18n/languages.ts).
  defaultLanguage    String   @default("en") @map("default_language") @db.VarChar(8)
  // branding: { coverPhotoUrls, address, contactPhone, contactEmail, websiteUrl, ... }
  branding           Json     @default("{}")
  // features: { installmentPlans, inAppMessaging, transportFeeModule, photoGallery }
  features           Json     @default("{\"installmentPlans\":false,\"inAppMessaging\":false,\"transportFeeModule\":true,\"photoGallery\":false}")
  receiptSequence    Int      @default(0) @map("receipt_sequence")
  // Subscription (docs/SPEC-subscriptions.md). The plan is what the school pays
  // for; module flags in `features` are what is switched on. Status (active /
  // renewal due / grace / expired) is derived from ends_on, never stored.
  subscriptionPlan     SubscriptionPlan @default(basic) @map("subscription_plan")
  subscriptionStartsOn DateTime         @default(dbgenerated("CURRENT_DATE")) @map("subscription_starts_on") @db.Date
  subscriptionEndsOn   DateTime         @default(dbgenerated("((CURRENT_DATE + '1 year'::interval) - '1 day'::interval)")) @map("subscription_ends_on") @db.Date
  /// Franchise / group the school belongs to (head office view), if any.
  groupId              String?          @map("group_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  users                    User[]
  subscriptionRenewals     SubscriptionRenewal[]
  circularBranches         GroupCircularBranch[]
  admissionEnquiries       AdmissionEnquiry[]
  admissionActivities      AdmissionActivity[]
  group                    SchoolGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  students                 Student[]
  classes                  Class[]
  feeStructures            FeeStructure[]
  studentFees              StudentFee[]
  paymentOrders            PaymentOrder[]
  transactions             PaymentTransaction[]
  reports                  Report[]
  notifications            Notification[]
  receipts                 Receipt[]
  discountTypes            DiscountType[]
  studentDiscounts         StudentDiscount[]
  customFieldDefinitions   CustomFieldDefinition[]
  studentCustomFieldValues StudentCustomFieldValue[]
  transportSlabs           TransportSlab[]
  subjects                 Subject[]
  teacherSubjects          TeacherSubject[]
  documentCategories       DocumentCategory[]
  accountantDocuments      AccountantDocument[]
  feeConcessions           FeeConcession[]
  timetableSlots           TimetableSlot[]
  paymentClaims            PaymentClaim[]
  studentNotes             StudentNote[]
  attendanceRecords        AttendanceRecord[]
  schoolHolidays           SchoolHoliday[]
  schoolEvents             SchoolEvent[]
  broadcasts               Broadcast[]
  periodTimings            PeriodTiming[]
  classPeriodTimings       ClassPeriodTiming[]
  classReminderSettings    ClassReminderSetting[]
  paymentGateway           TenantPaymentGateway?
  aiUsage                  AiUsage[]
  insightAlerts            InsightAlert[]
  pettyCashSetting         PettyCashSetting?
  pettyCashCategories      PettyCashCategory[]
  pettyCashPayees          PettyCashPayee[]
  transportRoutes          TransportRoute[]
  busTrips                 BusTrip[]
  libraryBooks             LibraryBook[]
  libraryCopies            LibraryCopy[]
  libraryLoans             LibraryLoan[]
  librarySettings          LibrarySettings?
  admissionFollowUps       AdmissionFollowUp[]
  admissionDocuments       AdmissionDocument[]
  admissionPayments        AdmissionPayment[]
  visitors                 Visitor[]
  callLogs                 CallLog[]
  transportStops           TransportStop[]
  studentTransports        StudentTransport[]
  holidayNotices           HolidayNotice[]
  pettyCashEntries         PettyCashEntry[]
  pettyCashCounts          PettyCashCount[]
  syllabusTopics           SyllabusTopic[]
  hrSetting                HrSetting?
  employees                Employee[]
  employeeDocuments        EmployeeDocument[]
  staffFolders             StaffFolder[]
  staffFiles               StaffFile[]
  staffAttendance          StaffAttendance[]
  leaveTypes               LeaveType[]
  leaveRequests            LeaveRequest[]
  salaryStructures         SalaryStructure[]
  payRuns                  PayRun[]
  payRunLines              PayRunLine[]
  payRunLineItems          PayRunLineItem[]

  @@index([groupId])
  @@map("tenants")
}

/// A franchise: schools (branches) seen together by head office users.
model SchoolGroup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  /// HH:MM in each school's own timezone: attendance not marked by then is flagged to the head office.
  attendanceCutoff String @default("10:00") @map("attendance_cutoff")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenants   Tenant[]
  users     User[]
  circulars GroupCircular[]

  @@map("school_groups")
}

enum CircularAudience {
  staff
  staff_and_parents
}

/// A head office circular (the only thing a head office creates): delivered
/// to the staff, and optionally the parents, of the chosen branches.
model GroupCircular {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId   String           @map("group_id") @db.Uuid
  title     String
  body      String
  audience  CircularAudience
  createdBy String           @map("created_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at")

  group    SchoolGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  branches GroupCircularBranch[]

  @@index([groupId, createdAt])
  @@map("group_circulars")
}

/// One branch a circular went to, with how many people it reached there.
model GroupCircularBranch {
  circularId String @map("circular_id") @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  staffCount  Int @default(0) @map("staff_count")
  parentCount Int @default(0) @map("parent_count")

  circular GroupCircular @relation(fields: [circularId], references: [id], onDelete: Cascade)
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([circularId, tenantId])
  @@index([tenantId])
  @@map("group_circular_branches")
}

enum SubscriptionPlan {
  basic
  premium
  premium_max
}

/// One renewal marked by the platform team (append-only history).
model SubscriptionRenewal {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  plan             SubscriptionPlan
  previousEndsOn   DateTime         @map("previous_ends_on") @db.Date
  startsOn         DateTime         @map("starts_on") @db.Date
  endsOn           DateTime         @map("ends_on") @db.Date
  /// Rupees received, if recorded.
  amount           Decimal?         @db.Decimal(12, 2)
  reference        String?
  note             String?
  renewedBy        String           @map("renewed_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("subscription_renewals")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  phone        String?
  email        String?
  name         String
  role         Role
  profession   String?
  passwordHash String?  @map("password_hash")
  fcmTokens    String[] @default([]) @map("fcm_tokens")
  isVerified   Boolean  @default(false) @map("is_verified")
  // Language the user picked (en | kn | hi); null = follow the school's default.
  preferredLanguage String? @map("preferred_language") @db.VarChar(8)
  // head_office users only: the group whose schools they see. Their tenant_id
  // is one school of the group (a user needs one) and is never used for scope.
  groupId      String?  @map("group_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group            SchoolGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  linkedStudents   StudentParent[]
  reports          Report[]        @relation("TeacherReports")
  refreshTokens    RefreshToken[]
  notifications    Notification[]
  recordedReceipts Receipt[]       @relation("ReceiptRecordedBy")
  taughtClasses    ClassTeacher[]
  taughtSubjects   TeacherSubject[]
  timetableSlots   TimetableSlot[]
  submittedClaims  PaymentClaim[]  @relation("PaymentClaimSubmitter")
  reviewedClaims   PaymentClaim[]  @relation("PaymentClaimReviewer")
  markedAttendance AttendanceRecord[] @relation("AttendanceMarkedBy")
  sentBroadcasts   Broadcast[]        @relation("BroadcastSender")
  consentResponses ConsentResponse[]
  authoredStudentNotes StudentNote[]
  classReminderSetting ClassReminderSetting?
  pettyCashReceived    PettyCashEntry[] @relation("PettyCashRecipient")
  employee             Employee?
  driverOf             PettyCashPayee?       @relation("DriverLogin")
  busTrips             BusTrip[]
  libraryLoans         LibraryLoan[]

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([phone])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  deviceId  String?   @map("device_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Student ──────────────────────────────────────────────────────────────────

model Student {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  name            String
  admissionNo     String      @map("admission_no")
  // Optional class roll number; attendance lists sort by it, then name.
  rollNo          String?     @map("roll_no")
  dob             DateTime?   @db.Date
  gender          Gender?
  bloodGroup      BloodGroup? @map("blood_group")
  caste           Caste?
  photoUrl        String?     @map("photo_url")
  classId         String      @map("class_id") @db.Uuid
  transportSlabId String?     @map("transport_slab_id") @db.Uuid
  // Transfer certificate (S3 key) — only used by schools with features.transferCertificate.
  tcFileKey       String?     @map("tc_file_key")
  tcUploadedAt    DateTime?   @map("tc_uploaded_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class             Class                     @relation(fields: [classId], references: [id])
  transportSlab     TransportSlab?            @relation(fields: [transportSlabId], references: [id])
  parents           StudentParent[]
  fees              StudentFee[]
  reports           Report[]
  receipts          Receipt[]
  discounts         StudentDiscount[]
  customFieldValues StudentCustomFieldValue[]
  consentResponses  ConsentResponse[]
  paymentClaims     PaymentClaim[]
  notes             StudentNote[]
  attendance        AttendanceRecord[]
  concessions       FeeConcession[]
  transport         StudentTransport?
  libraryLoans      LibraryLoan[]

  @@unique([tenantId, admissionNo])
  @@index([tenantId])
  @@index([classId])
  @@map("students")
}

model StudentParent {
  studentId String           @map("student_id") @db.Uuid
  parentId  String           @map("parent_id") @db.Uuid
  relation  GuardianRelation @default(guardian)
  isPrimary Boolean          @default(false) @map("is_primary")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  User    @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
  @@index([parentId])
  @@map("student_parents")
}

// ─── Class ────────────────────────────────────────────────────────────────────

model Class {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  section      String?
  academicYear String   @map("academic_year")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students           Student[]
  teachers           ClassTeacher[]
  subjectAssignments TeacherSubject[]
  feeStructureLinks  FeeStructureClass[]
  reports            Report[]
  receipts           Receipt[]
  timetableSlots     TimetableSlot[]
  attendanceRecords  AttendanceRecord[]
  broadcasts         Broadcast[]
  periodTimings      ClassPeriodTiming[]
  consentForms       ConsentFormClass[]
  syllabusTopics     SyllabusTopic[]

  @@unique([tenantId, name, section, academicYear])
  @@index([tenantId])
  @@map("classes")
}

// Many-to-many: a class can have co-teachers, a teacher can teach several classes.
// isClassTeacher distinguishes the class's homeroom/in-charge teacher (who may
// broadcast text notices to the whole class) from a co-/subject-teacher who only
// gained access to the class via a TeacherSubject assignment (homework-only).
model ClassTeacher {
  classId        String  @map("class_id") @db.Uuid
  teacherId      String  @map("teacher_id") @db.Uuid
  isClassTeacher Boolean @default(false) @map("is_class_teacher")

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([classId, teacherId])
  @@index([teacherId])
  @@map("class_teachers")
}

// ─── Subjects ─────────────────────────────────────────────────────────────────

model Subject {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherSubject[]
  timetableSlots     TimetableSlot[]
  broadcasts         Broadcast[]
  syllabusTopics     SyllabusTopic[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("subjects")
}

// A teacher teaches a subject in a class. Creating this row also upserts a
// ClassTeacher row (see TeachersService) so the teacher gains broadcast access to
// the class without being flagged as its class teacher.
model TeacherSubject {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, classId])
  @@index([teacherId])
  @@index([classId])
  @@map("teacher_subjects")
}

// ─── Syllabus (feature flag `syllabus`) ────────────────────────────────────────

/// One topic of a class's subject plan, in teaching order. The admin sets the
/// list and the date each topic should be finished by; the subject teacher
/// marks it covered. On time / late is derived from these dates, never stored.
model SyllabusTopic {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  classId     String    @map("class_id") @db.Uuid
  subjectId   String    @map("subject_id") @db.Uuid
  /// Optional chapter or unit name the topic is grouped under.
  unit        String?
  title       String
  sortOrder   Int       @map("sort_order")
  /// The date the topic should be finished by.
  plannedBy   DateTime  @map("planned_by") @db.Date
  /// The day it was taught; null until covered.
  completedOn DateTime? @map("completed_on") @db.Date
  completedBy String?   @map("completed_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([tenantId, classId, subjectId, sortOrder])
  @@map("syllabus_topics")
}

// ─── Admissions pipeline (feature flag `admissions`) ───────────────────────────

enum AdmissionStage {
  enquiry
  campus_tour
  follow_up
  registration
  enrolled
  lost
}

enum AdmissionSource {
  walk_in
  phone
  website
  referral
  social_media
  other
}

/// A prospective student's family, from first enquiry to enrolment (or lost).
model AdmissionEnquiry {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  childName      String          @map("child_name")
  dob            DateTime?       @db.Date
  classSought    String?         @map("class_sought")
  parentName     String          @map("parent_name")
  phone          String
  email          String?
  source         AdmissionSource
  stage          AdmissionStage  @default(enquiry)
  tourOn         DateTime?       @map("tour_on") @db.Date
  nextFollowUpOn DateTime?       @map("next_follow_up_on") @db.Date
  lostReason     String?         @map("lost_reason")
  notes          String?
  assignedTo     String?         @map("assigned_to") @db.Uuid
  createdBy      String          @map("created_by") @db.Uuid
  stageChangedAt DateTime        @default(now()) @map("stage_changed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activities AdmissionActivity[]
  followUps  AdmissionFollowUp[]
  documents  AdmissionDocument[]
  payments   AdmissionPayment[]
  calls      CallLog[]

  @@index([tenantId, stage])
  @@index([tenantId, createdAt])
  @@index([tenantId, nextFollowUpOn])
  @@map("admission_enquiries")
}

/// Append-only timeline of an enquiry: created, stage changes, notes.
model AdmissionActivity {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  enquiryId  String          @map("enquiry_id") @db.Uuid
  kind       String
  fromStage  AdmissionStage? @map("from_stage")
  toStage    AdmissionStage? @map("to_stage")
  note       String?
  byUserId   String          @map("by_user_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiry AdmissionEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId, createdAt])
  @@map("admission_activities")
}

// ─── Timetable (Addendum 4 / A10) ──────────────────────────────────────────────

// One period, one class, one day — the admin-managed weekly grid a teacher's
// dashboard reads from. dayOfWeek: 1=Monday .. 6=Saturday.
model TimetableSlot {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  teacherId    String   @map("teacher_id") @db.Uuid
  classId      String   @map("class_id") @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  dayOfWeek    Int      @map("day_of_week")
  periodNumber Int      @map("period_number")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([tenantId, classId, dayOfWeek, periodNumber])
  @@index([tenantId, teacherId])
  @@index([tenantId, classId])
  @@map("timetable_slots")
}

// ─── Fees ─────────────────────────────────────────────────────────────────────

model FeeStructure {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  dueDate       DateTime @map("due_date") @db.Date
  lateFeePerDay Decimal  @default(0) @map("late_fee_per_day") @db.Decimal(8, 2)
  academicYear  String   @map("academic_year")
  // System-generated plans (e.g. the per-tenant "Previous Year Dues" arrears plan
  // created by the year-end rollover) are hidden from the normal fee-plan UI/list.
  isSystem      Boolean  @default(false) @map("is_system")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes     FeeStructureClass[]
  items       FeeItem[]
  studentFees StudentFee[]

  @@unique([tenantId, name, academicYear])
  @@index([tenantId])
  @@map("fee_structures")
}

// Many-to-many: one fee plan can span multiple classes/groups (e.g. an AS/A-Level
// plan spanning Groups 11 & 12), and a class can be covered by more than one plan.
model FeeStructureClass {
  feeStructureId String @map("fee_structure_id") @db.Uuid
  classId        String @map("class_id") @db.Uuid

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([feeStructureId, classId])
  @@index([classId])
  @@map("fee_structure_classes")
}

model FeeItem {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feeStructureId     String           @map("fee_structure_id") @db.Uuid
  label              String
  amount             Decimal          @db.Decimal(12, 2)
  billingFrequency   BillingFrequency @default(one_time) @map("billing_frequency")
  // Only meaningful when billingFrequency = quarterly — number of months each
  // quarter spans, e.g. [3,3,2,2]. Quarters are weighted by these counts rather
  // than split evenly, since real school terms are uneven.
  quarterMonthCounts Int[]            @default([]) @map("quarter_month_counts")
  // Marks the plan's transport/van fee component — when a student has a
  // TransportSlab assigned, its monthlyAmount overrides this item's manually
  // entered amount for that student.
  isTransportFee     Boolean          @default(false) @map("is_transport_fee")

  feeStructure         FeeStructure          @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  studentFeeComponents StudentFeeComponent[]
  studentDiscounts     StudentDiscount[]
  feeConcessions       FeeConcession[]

  @@map("fee_items")
}

model StudentFee {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  feeStructureId String    @map("fee_structure_id") @db.Uuid
  amountDue      Decimal   @map("amount_due") @db.Decimal(12, 2)
  amountPaid     Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status         FeeStatus @default(pending)
  dueDate        DateTime  @map("due_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure          @relation(fields: [feeStructureId], references: [id])
  orders       PaymentOrder[]
  receipts     Receipt[]
  components   StudentFeeComponent[]
  paymentClaims PaymentClaim[]

  @@unique([studentId, feeStructureId])
  @@index([tenantId])
  @@index([studentId])
  @@map("student_fees")
}

// The per-component, per-period ledger row exploded from a FeeItem's
// billingFrequency when a StudentFee is assigned (1 row for one_time, 12 for
// monthly, N for quarterly). This is what gives an always-current running
// balance per fee component instead of one lump amount per plan.
model StudentFeeComponent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentFeeId String    @map("student_fee_id") @db.Uuid
  feeItemId    String    @map("fee_item_id") @db.Uuid
  // e.g. "2026-06" for a monthly period, or "Q1" for a quarterly one, "Full Year" for one_time
  periodLabel  String    @map("period_label")
  periodStart  DateTime  @map("period_start") @db.Date
  periodEnd    DateTime  @map("period_end") @db.Date
  dueDate      DateTime  @map("due_date") @db.Date
  amountDue    Decimal   @map("amount_due") @db.Decimal(12, 2)
  amountPaid   Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status       FeeStatus @default(pending)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  studentFee  StudentFee          @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  feeItem     FeeItem             @relation(fields: [feeItemId], references: [id])
  allocations ReceiptAllocation[]

  @@unique([studentFeeId, feeItemId, periodLabel])
  @@index([studentFeeId])
  @@map("student_fee_components")
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model PaymentOrder {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  studentFeeId   String             @map("student_fee_id") @db.Uuid
  gateway        PaymentGateway     @default(razorpay)
  gatewayOrderId String             @map("gateway_order_id")
  amount         Decimal            @db.Decimal(12, 2)
  currency       String             @default("INR")
  status         PaymentOrderStatus @default(created)
  idempotencyKey String             @unique @map("idempotency_key")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentFee  StudentFee          @relation(fields: [studentFeeId], references: [id])
  transaction PaymentTransaction?

  @@index([tenantId])
  @@index([gatewayOrderId])
  @@map("payment_orders")
}

model PaymentTransaction {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  paymentOrderId   String   @unique @map("payment_order_id") @db.Uuid
  gatewayPaymentId String   @map("gateway_payment_id")
  gatewaySignature String?  @map("gateway_signature")
  amount           Decimal  @db.Decimal(12, 2)
  paidAt           DateTime @map("paid_at")
  receiptUrl       String?  @map("receipt_url")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id])

  @@index([tenantId])
  @@map("payment_transactions")
}

// ─── Receipts ─────────────────────────────────────────────────────────────────
// One row per payment (online or offline) — the source of "paid fee history" and
// the printable cash/cheque/bank-transfer receipt. studentId/classId are
// denormalized to capture the class the student was in at time of payment, since
// Student.classId can change later (e.g. promotion/transfer).

model Receipt {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  receiptNumber  String        @map("receipt_number")
  studentFeeId   String        @map("student_fee_id") @db.Uuid
  studentId      String        @map("student_id") @db.Uuid
  classId        String        @map("class_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  reference      String?
  paidOn         DateTime      @map("paid_on") @db.Date
  notes          String?
  recordedBy     String?       @map("recorded_by") @db.Uuid
  paymentOrderId String?       @unique @map("payment_order_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")

  // Addendum 4 / A8 — optional discount/concession label on the transaction.
  // Record-keeping only: does not itself alter amountDue/amountPaid.
  discountTypeId String?  @map("discount_type_id") @db.Uuid
  discountAmount Decimal? @map("discount_amount") @db.Decimal(12, 2)
  discountNote   String?  @map("discount_note")

  // Addendum 4 / A9 — generated receipt PDF + delivery tracking.
  pdfKey             String?   @map("pdf_key")
  pdfGeneratedAt     DateTime? @map("pdf_generated_at")
  receiptDeliveredAt DateTime? @map("receipt_delivered_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentFee     StudentFee          @relation(fields: [studentFeeId], references: [id])
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class          Class               @relation(fields: [classId], references: [id])
  recordedByUser User?               @relation("ReceiptRecordedBy", fields: [recordedBy], references: [id])
  discountType   DiscountType?       @relation(fields: [discountTypeId], references: [id])
  allocations    ReceiptAllocation[]
  paymentClaim   PaymentClaim?

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, paidOn])
  @@index([studentId])
  @@index([classId])
  @@map("receipts")
}

// Lets one receipt cover multiple fee components in a single transaction
// (e.g. Poorna's "Tuition & Van Fee" combined cash receipts). The parent
// Receipt.amount remains the total; these rows are how much of it went to
// which StudentFeeComponent.
model ReceiptAllocation {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId             String  @map("receipt_id") @db.Uuid
  studentFeeComponentId String  @map("student_fee_component_id") @db.Uuid
  amount                Decimal @db.Decimal(12, 2)

  receipt             Receipt             @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  studentFeeComponent StudentFeeComponent @relation(fields: [studentFeeComponentId], references: [id])

  @@index([receiptId])
  @@index([studentFeeComponentId])
  @@map("receipt_allocations")
}

// ─── Payment Claims (Addendum 4 / A12) ─────────────────────────────────────────

// A parent's self-reported "I already paid this elsewhere" submission. Never
// written straight to Receipt/StudentFee — kept as its own pending record
// until an accountant/admin approves it, so an unverified claim can never look
// identical to a verified, staff-recorded payment on the official fee ledger.
model PaymentClaim {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  studentId     String             @map("student_id") @db.Uuid
  studentFeeId  String             @map("student_fee_id") @db.Uuid
  submittedBy   String             @map("submitted_by") @db.Uuid
  fileKey       String             @map("file_key")
  claimedAmount Decimal?           @map("claimed_amount") @db.Decimal(12, 2)
  claimedDate   DateTime?          @map("claimed_date") @db.Date
  claimedMode   ClaimPaymentMode?  @map("claimed_mode")
  note          String?
  status        PaymentClaimStatus @default(pending)
  reviewedBy    String?            @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?          @map("reviewed_at")
  reviewNote    String?            @map("review_note")
  // Receipt recorded when the claim was approved. Null for pending/rejected claims
  // and for claims approved before this column existed.
  receiptId     String?            @unique @map("receipt_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  submitter  User       @relation("PaymentClaimSubmitter", fields: [submittedBy], references: [id], onDelete: Cascade)
  reviewer   User?      @relation("PaymentClaimReviewer", fields: [reviewedBy], references: [id])
  receipt    Receipt?   @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  check      PaymentClaimCheck?

  @@index([tenantId])
  @@index([studentFeeId])
  @@index([status])
  @@map("payment_claims")
}

/// What the AI read from a claim's proof screenshot (docs/SPEC-ai.md 1.3), and
/// what didn't add up. Advisory only: the accountant still approves or rejects.
model PaymentClaimCheck {
  claimId   String    @id @map("claim_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  /// "done" | "failed" (couldn't read it)
  status    String
  amount    Decimal?  @db.Decimal(12, 2)
  paidOn    DateTime? @map("paid_on") @db.Date
  /// UPI/UTR/cheque/transaction reference as printed.
  reference String?
  payee     String?
  /// e.g. ["amount_mismatch", "reference_reused", "date_mismatch", "unreadable"]
  flags     Json      @default("[]")
  createdAt DateTime  @default(now()) @map("created_at")

  claim PaymentClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([tenantId, reference])
  @@map("payment_claim_checks")
}

// ─── Reports ──────────────────────────────────────────────────────────────────

model Report {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  studentId    String       @map("student_id") @db.Uuid
  classId      String       @map("class_id") @db.Uuid
  teacherId    String       @map("teacher_id") @db.Uuid
  type         ReportType   @default(academic)
  term         String
  academicYear String       @map("academic_year")
  content      Json
  pdfKey       String?      @map("pdf_key")
  status       ReportStatus @default(draft)
  publishedAt  DateTime?    @map("published_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class               @relation(fields: [classId], references: [id])
  teacher      User                @relation("TeacherReports", fields: [teacherId], references: [id])
  readReceipts ReportReadReceipt[]

  @@index([tenantId])
  @@index([studentId])
  @@index([teacherId])
  @@map("reports")
}

model ReportReadReceipt {
  reportId String   @map("report_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  readAt   DateTime @default(now()) @map("read_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@id([reportId, userId])
  @@map("report_read_receipts")
}

// ─── Student Notes ────────────────────────────────────────────────────────────
// A private running log a teacher (scoped to their own classes) or
// admin/super_admin can add about one student — free-text notes, minutes of
// meeting, complaints, or "discussion with parent" entries. Deliberately a
// separate model from Report (the *parent-visible* progress report) — these
// rows must never be exposed to a parent or accounts role.
model StudentNote {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  studentId String          @map("student_id") @db.Uuid
  authorId  String          @map("author_id") @db.Uuid
  type      StudentNoteType @default(note)
  content   String          @db.Text
  createdAt DateTime        @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@map("student_notes")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel
  title     String?
  body      String
  data      Json?
  status    NotificationStatus  @default(pending)
  error     String?
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")
  // Set for notice/homework fan-out rows; seenAt is when this parent opened the item.
  broadcastId String?   @map("broadcast_id") @db.Uuid
  seenAt      DateTime? @map("seen_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcast Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([broadcastId])
  @@map("notifications")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  diff       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─── Discounts / Concessions ──────────────────────────────────────────────────

// Per-tenant catalog of discount types (Sibling Discount, Concession, Full
// Waiver, a named sponsor, ...) — names/kinds vary school to school.
model DiscountType {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  name      String
  kind      DiscountKind
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments StudentDiscount[]
  receipts    Receipt[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("discount_types")
}

// A discount tagged onto a student, applied automatically when their
// StudentFeeComponent rows are generated. feeItemId null = applies pro-rata
// across every component on the plan; set = scoped to one component.
model StudentDiscount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  discountTypeId String   @map("discount_type_id") @db.Uuid
  feeItemId      String?  @map("fee_item_id") @db.Uuid
  percentage     Decimal? @db.Decimal(5, 2)
  fixedAmount    Decimal? @map("fixed_amount") @db.Decimal(12, 2)
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  discountType DiscountType @relation(fields: [discountTypeId], references: [id])
  feeItem      FeeItem?     @relation(fields: [feeItemId], references: [id])

  @@index([tenantId])
  @@index([studentId])
  @@map("student_discounts")
}

// A percentage concession staff applied to a student's outstanding fees
// (features.feeConcession). The fee rows are reduced at the time; this row
// keeps what was given, by whom and on which school day, for the dashboard.
model FeeConcession {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  // null = every fee component; set = one component (e.g. Tuition)
  feeItemId   String?  @map("fee_item_id") @db.Uuid
  percentage  Decimal  @db.Decimal(5, 2)
  amount      Decimal  @db.Decimal(12, 2)
  reason      String?
  // Calendar day in the school's timezone, for "concession given today".
  givenOn     DateTime @map("given_on") @db.Date
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeItem FeeItem? @relation(fields: [feeItemId], references: [id])

  @@index([tenantId, givenOn])
  @@index([studentId])
  @@map("fee_concessions")
}

// ─── Custom Student Fields ────────────────────────────────────────────────────

// Admin-defined extra student fields (e.g. Karnataka's "SATS No", a
// religion/mother-tongue "Category") — schema stays universal, schools
// configure what they specifically need to capture.
model CustomFieldDefinition {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  label       String
  fieldType   CustomFieldType @map("field_type")
  // Choices for fieldType = dropdown, e.g. ["Hindu/Kannada", "Christian/English", ...]
  options     Json?
  // Sensitive fields are restricted to admin/super_admin view and excluded from exports.
  isSensitive Boolean         @default(false) @map("is_sensitive")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values StudentCustomFieldValue[]

  @@unique([tenantId, label])
  @@index([tenantId])
  @@map("custom_field_definitions")
}

model StudentCustomFieldValue {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  studentId         String   @map("student_id") @db.Uuid
  fieldDefinitionId String   @map("field_definition_id") @db.Uuid
  value             String
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student         Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fieldDefinition CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([studentId, fieldDefinitionId])
  @@index([tenantId])
  @@map("student_custom_field_values")
}

// ─── Transport ────────────────────────────────────────────────────────────────

// Distance-range → monthly amount, per tenant. Gated by the existing
// Tenant.features.transportFeeModule flag.
model TransportSlab {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  minDistanceKm Decimal  @map("min_distance_km") @db.Decimal(6, 2)
  maxDistanceKm Decimal  @map("max_distance_km") @db.Decimal(6, 2)
  monthlyAmount Decimal  @map("monthly_amount") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students Student[]

  @@index([tenantId])
  @@map("transport_slabs")
}

// School bus routes (feature flag `transport`, Premium). The driver and the
// optional attendant are ground staff from the petty cash payee list. Parents
// see the route, their child's stop and the driver's phone only for a child
// assigned to that route.
model TransportRoute {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String
  vehicleNumber String?  @map("vehicle_number")
  driverId      String?  @map("driver_id") @db.Uuid
  attendantId   String?  @map("attendant_id") @db.Uuid
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driver    PettyCashPayee?    @relation("RouteDriver", fields: [driverId], references: [id], onDelete: SetNull)
  attendant PettyCashPayee?    @relation("RouteAttendant", fields: [attendantId], references: [id], onDelete: SetNull)
  stops     TransportStop[]
  students  StudentTransport[]
  trips     BusTrip[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("transport_routes")
}

/// A stop on a route, in pick-up order; times are school-local HH:MM.
model TransportStop {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  routeId    String   @map("route_id") @db.Uuid
  name       String
  sortOrder  Int      @map("sort_order")
  pickupTime String?  @map("pickup_time") @db.VarChar(5)
  dropTime   String?  @map("drop_time") @db.VarChar(5)
  /// Where the stop is, for the parents' arrival time (set in the console or
  /// by the driver standing at it).
  lat        Float?
  lng        Float?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route    TransportRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  students StudentTransport[]

  @@index([routeId, sortOrder])
  @@map("transport_stops")
}

/// A student on a school bus route (at most one), optionally at a stop.
model StudentTransport {
  studentId String   @id @map("student_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  routeId   String   @map("route_id") @db.Uuid
  stopId    String?  @map("stop_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)
  stop    TransportStop? @relation(fields: [stopId], references: [id], onDelete: Restrict)

  @@index([tenantId, routeId])
  @@map("student_transport")
}

enum BusTripDirection {
  pickup
  drop
}

/// A bus run a driver started from the app. Only the latest position is kept
/// (no trail). One open trip per route (partial unique index in the migration).
model BusTrip {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  routeId      String           @map("route_id") @db.Uuid
  driverUserId String           @map("driver_user_id") @db.Uuid
  direction    BusTripDirection
  startedAt    DateTime         @default(now()) @map("started_at")
  endedAt      DateTime?        @map("ended_at")
  lat          Float?
  lng          Float?
  /// Metres per second, degrees, metres (as the phone reports them).
  speed        Float?
  heading      Float?
  accuracy     Float?
  positionAt   DateTime?        @map("position_at")
  /// Stops the bus has reached on this trip (bus-eta.ts).
  passedStopIds  String[]       @default([]) @map("passed_stop_ids")
  /// Stops whose parents got the "arriving in 5 minutes" push.
  alertedStopIds String[]       @default([]) @map("alerted_stop_ids")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route  TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  driver User           @relation(fields: [driverUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, routeId, startedAt])
  @@index([driverUserId, endedAt])
  @@map("bus_trips")
}

// ─── Library (Premium Max, flag library) ─────────────────────────────────────

/// A title in the catalogue; the physical books are its copies.
model LibraryBook {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  title     String
  author    String?
  isbn      String?
  publisher String?
  category  String?
  language  String?
  shelf     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  copies LibraryCopy[]

  @@index([tenantId, title])
  @@map("library_books")
}

/// Not "issued": a copy is out when it has an open loan (derived, never stored).
enum LibraryCopyStatus {
  available
  lost
  damaged
  withdrawn
}

/// One physical book, labelled with its accession number.
model LibraryCopy {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  bookId      String            @map("book_id") @db.Uuid
  accessionNo String            @map("accession_no")
  status      LibraryCopyStatus @default(available)
  createdAt   DateTime          @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  book   LibraryBook   @relation(fields: [bookId], references: [id], onDelete: Restrict)
  loans  LibraryLoan[]

  @@unique([tenantId, accessionNo])
  @@index([bookId])
  @@map("library_copies")
}

enum LibraryFineStatus {
  none
  due
  paid
  waived
}

/// A copy lent to a student or a staff member (exactly one of the two). One
/// open loan per copy (partial unique index in the migration).
model LibraryLoan {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  copyId     String            @map("copy_id") @db.Uuid
  studentId  String?           @map("student_id") @db.Uuid
  userId     String?           @map("user_id") @db.Uuid
  issuedOn   DateTime          @map("issued_on") @db.Date
  dueOn      DateTime          @map("due_on") @db.Date
  returnedOn DateTime?         @map("returned_on") @db.Date
  /// Set at return: days late x the school's fine per day.
  fineAmount Decimal           @default(0) @map("fine_amount") @db.Decimal(12, 2)
  fineStatus LibraryFineStatus @default(none) @map("fine_status")
  issuedBy   String            @map("issued_by") @db.Uuid
  returnedBy String?           @map("returned_by") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at")

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  copy    LibraryCopy @relation(fields: [copyId], references: [id], onDelete: Restrict)
  student Student?    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  user    User?       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, returnedOn, dueOn])
  @@index([studentId])
  @@index([userId])
  @@map("library_loans")
}

model LibrarySettings {
  tenantId        String   @id @map("tenant_id") @db.Uuid
  studentLoanDays Int      @default(14) @map("student_loan_days")
  staffLoanDays   Int      @default(30) @map("staff_loan_days")
  maxStudentBooks Int      @default(2) @map("max_student_books")
  maxStaffBooks   Int      @default(5) @map("max_staff_books")
  finePerDay      Decimal  @default(0) @map("fine_per_day") @db.Decimal(12, 2)
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("library_settings")
}

// ─── Front desk (receptionist; part of the admissions flag) ──────────────────

enum FollowUpKind {
  call
  visit
  whatsapp
  email
  other
}

/// A to-do on an enquiry (call back, campus visit...). The enquiry's
/// next_follow_up_on mirrors the earliest open one.
model AdmissionFollowUp {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  enquiryId String       @map("enquiry_id") @db.Uuid
  dueOn     DateTime     @map("due_on") @db.Date
  kind      FollowUpKind
  note      String?
  doneAt    DateTime?    @map("done_at")
  doneBy    String?      @map("done_by") @db.Uuid
  outcome   String?
  createdBy String       @map("created_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiry AdmissionEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([tenantId, doneAt, dueOn])
  @@index([enquiryId])
  @@map("admission_follow_ups")
}

/// A document received for an enquiry; a kind with no row is still pending.
/// Kinds are fixed in code (reception.constants.ts).
model AdmissionDocument {
  enquiryId  String   @map("enquiry_id") @db.Uuid
  kind       String
  tenantId   String   @map("tenant_id") @db.Uuid
  receivedAt DateTime @default(now()) @map("received_at")
  receivedBy String   @map("received_by") @db.Uuid
  note       String?

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiry AdmissionEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@id([enquiryId, kind])
  @@map("admission_documents")
}

enum DeskPaymentMode {
  cash
  upi
  card
  cheque
  bank_transfer
}

/// Money taken at the front desk for an enquiry (registration fee, form).
/// Receipt numbers run per school; a mistake is voided with a reason, never deleted.
model AdmissionPayment {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  enquiryId  String          @map("enquiry_id") @db.Uuid
  receiptNo  Int             @map("receipt_no")
  purpose    String
  amount     Decimal         @db.Decimal(12, 2)
  mode       DeskPaymentMode
  reference  String?
  receivedOn DateTime        @map("received_on") @db.Date
  receivedBy String          @map("received_by") @db.Uuid
  voidedAt   DateTime?       @map("voided_at")
  voidedBy   String?         @map("voided_by") @db.Uuid
  voidReason String?         @map("void_reason")
  createdAt  DateTime        @default(now()) @map("created_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiry AdmissionEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Restrict)

  @@unique([tenantId, receiptNo])
  @@index([enquiryId])
  @@map("admission_payments")
}

enum VisitorPurpose {
  admission_enquiry
  parent_meeting
  interview
  vendor
  delivery
  official
  other
}

/// Front-desk visitor book: signed in, then signed out.
model Visitor {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  name       String
  phone      String?
  purpose    VisitorPurpose
  whomToMeet String?        @map("whom_to_meet")
  people     Int            @default(1)
  note       String?
  inAt       DateTime       @default(now()) @map("in_at")
  outAt      DateTime?      @map("out_at")
  createdBy  String         @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, inAt])
  @@map("visitors")
}

enum CallDirection {
  incoming
  outgoing
}

/// A phone call taken or made at the desk, optionally about an enquiry.
model CallLog {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  direction CallDirection
  name      String?
  phone     String
  enquiryId String?       @map("enquiry_id") @db.Uuid
  purpose   String?
  note      String?
  at        DateTime      @default(now())
  createdBy String        @map("created_by") @db.Uuid

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiry AdmissionEnquiry? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)

  @@index([tenantId, at])
  @@map("call_logs")
}

// ─── Bulk Import ──────────────────────────────────────────────────────────────

model ImportJob {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  initiatedBy String       @map("initiated_by") @db.Uuid
  fileName    String       @map("file_name")
  status      ImportStatus @default(pending)
  summary     Json?
  errorReport Json?        @map("error_report")
  createdAt   DateTime     @default(now()) @map("created_at")
  completedAt DateTime?    @map("completed_at")

  @@index([tenantId])
  @@map("import_jobs")
}

// ─── Accountant Documents (Addendum 4 / A13) ──────────────────────────────────

// Per-tenant catalog of document categories ("Bank Statement", "Reconciliation
// Sheet", "Cheque Scan", ...) — mirrors DiscountType's admin-configurable-list pattern.
model DocumentCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents AccountantDocument[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("document_categories")
}

// General-purpose working storage for the accounts team's own supporting
// documents — intentionally simple storage/retrieval, no auto-processing.
model AccountantDocument {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  uploadedBy String   @map("uploaded_by") @db.Uuid
  fileKey    String   @map("file_key")
  categoryId String   @map("category_id") @db.Uuid
  note       String?
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category DocumentCategory @relation(fields: [categoryId], references: [id])

  @@index([tenantId])
  @@index([categoryId])
  @@map("accountant_documents")
}

/// Daily attendance: one row per student per school day (docs/SPEC-improvements.md §2.1).
model AttendanceRecord {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  classId          String           @map("class_id") @db.Uuid
  studentId        String           @map("student_id") @db.Uuid
  date             DateTime         @db.Date
  status           AttendanceStatus
  markedBy         String           @map("marked_by") @db.Uuid
  markedAt         DateTime         @default(now()) @map("marked_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  note             String?
  // Whether parents currently hold an "absent" push for this day; drives
  // once-per-day alerts and the correction push when changed back.
  absenceAlertSent Boolean          @default(false) @map("absence_alert_sent")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marker  User    @relation("AttendanceMarkedBy", fields: [markedBy], references: [id])

  @@unique([tenantId, studentId, date])
  @@index([tenantId, classId, date])
  @@map("attendance_records")
}

/// Days excluded from attendance (no marking expected, not counted as unmarked).
model SchoolHoliday {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@map("school_holidays")
}

/// One morning push to parents per run of school holidays, keyed by the run's
/// first day, so a restart or a second API instance never sends it twice.
model HolidayNotice {
  tenantId  String   @map("tenant_id") @db.Uuid
  date      DateTime @db.Date
  sentCount Int      @default(0) @map("sent_count")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, date])
  @@map("holiday_notices")
}

enum SchoolEventType {
  EVENT
  PTM
}

/// School events and parent-teacher meetings shown on the mobile calendar
/// (holidays stay in SchoolHoliday). Dates are calendar days; end_date is null for one-day items.
model SchoolEvent {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  type        SchoolEventType
  title       String
  description String?
  startDate   DateTime        @map("start_date") @db.Date
  endDate     DateTime?       @map("end_date") @db.Date
  /// "HH:mm" 24-hour, school-local.
  startTime   String?         @map("start_time")
  endTime     String?         @map("end_time")
  venue       String?
  createdBy   String?         @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consentForm  ConsentForm?

  @@index([tenantId, startDate])
  @@map("school_events")
}

enum ConsentDecision {
  APPROVED
  DECLINED
}

/// Parent consent for an event (e.g. a school trip), sent to the parents of
/// students in the chosen classes. At most one per event.
model ConsentForm {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  eventId   String   @unique @map("event_id") @db.Uuid
  /// The consent wording parents agree to.
  body      String
  /// Last day parents can sign (school-local, inclusive).
  deadline  DateTime @db.Date
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  event     SchoolEvent        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  classes   ConsentFormClass[]
  responses ConsentResponse[]

  @@index([tenantId])
  @@map("consent_forms")
}

model ConsentFormClass {
  formId  String @map("form_id") @db.Uuid
  classId String @map("class_id") @db.Uuid

  form  ConsentForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  class Class       @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([formId, classId])
  @@index([classId])
  @@map("consent_form_classes")
}

/// One signed answer per student (from any of their parents); a parent can
/// change it until the deadline, and each change is audit-logged.
model ConsentResponse {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formId     String          @map("form_id") @db.Uuid
  studentId  String          @map("student_id") @db.Uuid
  /// Null once the parent account is removed; signedName keeps the record.
  parentId   String?         @map("parent_id") @db.Uuid
  decision   ConsentDecision
  /// Full name the parent typed as their signature.
  signedName String          @map("signed_name")
  note       String?
  signedAt   DateTime        @default(now()) @map("signed_at")

  form    ConsentForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  User?       @relation(fields: [parentId], references: [id], onDelete: SetNull)

  @@unique([formId, studentId])
  @@index([parentId])
  @@map("consent_responses")
}

/// One notice or homework message as sent (docs/SPEC-improvements.md §4.3);
/// each recipient's Notification row links back here for "seen by" counts.
model Broadcast {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  senderId    String        @map("sender_id") @db.Uuid
  classId     String?       @map("class_id") @db.Uuid
  subjectId   String?       @map("subject_id") @db.Uuid
  kind        BroadcastKind
  title       String?
  body        String
  /// [{ key, contentType }] — up to 3 images, or 1 PDF (notices only).
  attachments Json          @default("[]")
  createdAt   DateTime      @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sender        User           @relation("BroadcastSender", fields: [senderId], references: [id], onDelete: Cascade)
  class         Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([tenantId, senderId])
  @@index([tenantId, classId])
  @@map("broadcasts")
}

/// The school's bell schedule: start/end of each period number, for the teacher "Now / Next" strip.
model PeriodTiming {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  periodNumber Int      @map("period_number")
  /// "HH:MM", 24-hour, in the school's timezone.
  startTime    String   @map("start_time")
  endTime      String   @map("end_time")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodNumber])
  @@map("period_timings")
}

/// A class's own bell schedule. A class with any rows here uses only these;
/// every other class uses the school's period_timings.
model ClassPeriodTiming {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  classId      String   @map("class_id") @db.Uuid
  periodNumber Int      @map("period_number")
  /// "HH:MM", 24-hour, in the school's timezone.
  startTime    String   @map("start_time")
  endTime      String   @map("end_time")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, periodNumber])
  @@index([tenantId])
  @@map("class_period_timings")
}

/// A teacher's "next class" push. No row means the default (5 minutes before);
/// minutesBefore null means switched off.
model ClassReminderSetting {
  userId        String   @id @map("user_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  minutesBefore Int?     @map("minutes_before")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("class_reminder_settings")
}

/// A school's Razorpay account, set by the platform team. The two secrets are
/// AES-256-GCM encrypted with PAYMENT_SECRETS_KEY (an env var, never in the DB);
/// keyId is Razorpay's publishable key and is sent to the app as-is.
model TenantPaymentGateway {
  tenantId         String   @id @map("tenant_id") @db.Uuid
  keyId            String   @map("key_id")
  keySecretEnc     String   @map("key_secret_enc")
  webhookSecretEnc String   @map("webhook_secret_enc")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_payment_gateways")
}

/// One Claude call (docs/SPEC-ai.md): for the per-school monthly cap and billing.
model AiUsage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// e.g. "translate_notice", "report_remark"
  feature      String
  model        String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("ai_usage")
}

/// A pattern warning for staff (docs/SPEC-ai.md phase 2), recomputed nightly.
/// Text is not stored: clients render `kind` and each reason's i18n key + params.
model InsightAlert {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  /// e.g. "student_at_risk", "weekday_absence", "duplicate_utr"
  kind        String
  /// "info" | "warning" | "critical"
  severity    String
  /// "student" | "class" | "teacher" | "fee" | "claim" | "school"
  subjectType String    @map("subject_type")
  subjectId   String?   @map("subject_id") @db.Uuid
  /// Display name of the subject at the time (student/class/teacher name).
  subjectName String?   @map("subject_name")
  /// [{ key, params }] — why this alert exists.
  reasons     Json
  /// "admin" | "accounts" | "teacher"
  audience    String
  /// When audience is "teacher": who sees it (e.g. the class teacher).
  teacherId   String?   @map("teacher_id") @db.Uuid
  /// "open" | "dismissed" | "resolved"
  status      String    @default("open")
  /// Same alert on the next run updates this row instead of adding another.
  dedupeKey   String    @map("dedupe_key")
  dismissedAt DateTime? @map("dismissed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, audience])
  @@map("insight_alerts")
}

/// One row per timetable slot per school day once its reminder went out, so a
/// restart or a second API instance never sends it twice.
model ClassReminderSent {
  slotId    String   @map("slot_id") @db.Uuid
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  @@id([slotId, date])
  @@map("class_reminders_sent")
}

/// Demo requests from the marketing site's contact form (docs/SPEC-improvements.md §5.9).
/// Not tenant-scoped: these are prospective schools, before they're customers.
model ContactRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  schoolName     String    @map("school_name")
  city           String
  studentCount   Int       @map("student_count")
  /// E.164, e.g. +919876543210
  phone          String
  preferredTime  String?   @map("preferred_time")
  /// basic | premium | gold | unsure, picked on the demo form (optional).
  interestedPlan String?   @map("interested_plan")
  emailedAt      DateTime? @map("emailed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_requests")
}

/// Marketing-site "Download the price list" form: who asked for the plans PDF.
model PricingRequest {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolName String    @map("school_name")
  email      String
  /// E.164, e.g. +919876543210
  phone      String
  emailedAt  DateTime? @map("emailed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("pricing_requests")
}

/// Cookie-free marketing-site analytics (§5.10): daily totals only — no IPs,
/// user agents or visitor ids are ever stored.
model SiteEventCount {
  day   DateTime @db.Date
  event String
  path  String
  count Int      @default(0)

  @@id([day, event, path])
  @@map("site_event_counts")
}

// ─── Petty cash (admin console only; feature flag `pettyCash`) ───────────────

enum PettyCashPayeeType {
  VENDOR
  GROUND_STAFF
}

enum PettyCashEntryType {
  TOP_UP
  DISBURSEMENT
  EXPENSE
  RETURN
}

enum PettyCashStatus {
  PENDING
  APPROVED
  REJECTED
  VOIDED
}

/// One row per school; created lazily with defaults. Money is NUMERIC(12,2).
model PettyCashSetting {
  tenantId             String   @id @map("tenant_id") @db.Uuid
  /// Entries strictly above this need admin approval.
  approvalThreshold    Decimal  @default(2000) @map("approval_threshold") @db.Decimal(12, 2)
  /// Whole-school monthly budget; null = none set.
  monthlyBudget        Decimal? @map("monthly_budget") @db.Decimal(12, 2)
  /// An expense strictly above this must carry a receipt.
  receiptRequiredAbove Decimal  @default(500) @map("receipt_required_above") @db.Decimal(12, 2)
  /// A disbursement still open after this many days is overdue.
  overdueDays          Int      @default(7) @map("overdue_days")
  /// Record which notes and coins go in and out, and keep a count of the notes in hand.
  trackDenominations   Boolean  @default(false) @map("track_denominations")
  categoriesSeeded     Boolean  @default(false) @map("categories_seeded")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("petty_cash_settings")
}

model PettyCashCategory {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String
  monthlyBudget Decimal? @map("monthly_budget") @db.Decimal(12, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries PettyCashEntry[]

  @@unique([tenantId, name])
  @@map("petty_cash_categories")
}

/// Registered third-party cash recipients (vendors, ground staff). Never deleted, only deactivated.
model PettyCashPayee {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  type      PettyCashPayeeType
  name      String
  phone     String?
  notes     String?
  isActive  Boolean            @default(true) @map("is_active")
  /// Driver app access: the driver-role login made for this ground staff member.
  userId    String?            @unique @map("user_id") @db.Uuid
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?            @relation("DriverLogin", fields: [userId], references: [id], onDelete: SetNull)
  entries         PettyCashEntry[]
  drivenRoutes    TransportRoute[] @relation("RouteDriver")
  attendantRoutes TransportRoute[] @relation("RouteAttendant")

  @@index([tenantId, isActive])
  @@map("petty_cash_payees")
}

/// Append-only ledger row: no edit, no delete. Balance and open advances are
/// derived from APPROVED rows, never stored. Corrections = void + new entry.
model PettyCashEntry {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  type            PettyCashEntryType
  amount          Decimal            @db.Decimal(12, 2)
  date            DateTime           @db.Date
  categoryId      String?            @map("category_id") @db.Uuid
  description     String
  /// S3 key (private/{tenantId}/petty-cash/...), never a URL.
  receiptKey      String?            @map("receipt_key")
  recipientUserId String?            @map("recipient_user_id") @db.Uuid
  payeeId         String?            @map("payee_id") @db.Uuid
  settlesEntryId  String?            @map("settles_entry_id") @db.Uuid
  /// Notes and coins moved, when the school tracks them: {"in": {"500": 2}, "out": {"10": 1}}
  /// (rupee value -> count). in - out equals the entry's effect on the float.
  denominations   Json?
  status          PettyCashStatus
  createdBy       String             @map("created_by") @db.Uuid
  approvedBy      String?            @map("approved_by") @db.Uuid
  approvedAt      DateTime?          @map("approved_at")
  rejectionReason String?            @map("rejection_reason")
  voidReason      String?            @map("void_reason")
  voidedBy        String?            @map("voided_by") @db.Uuid
  voidedAt        DateTime?          @map("voided_at")
  createdAt       DateTime           @default(now()) @map("created_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      PettyCashCategory? @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  payee         PettyCashPayee?    @relation(fields: [payeeId], references: [id], onDelete: NoAction)
  recipientUser User?              @relation("PettyCashRecipient", fields: [recipientUserId], references: [id], onDelete: NoAction)
  settlesEntry  PettyCashEntry?    @relation("PettyCashSettles", fields: [settlesEntryId], references: [id], onDelete: NoAction)
  settlements   PettyCashEntry[]   @relation("PettyCashSettles")

  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([tenantId, type, status])
  @@index([settlesEntryId])
  @@map("petty_cash_entries")
}

/// A physical count of the petty cash box by note and coin (append-only). The
/// latest count plus the approved entries after it give the notes in hand.
model PettyCashCount {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// {"500": 3, "100": 7}: rupee value -> number of notes or coins.
  counts        Json
  total         Decimal  @db.Decimal(12, 2)
  /// Ledger balance when counted; total - ledgerBalance is the shortage or excess.
  ledgerBalance Decimal  @map("ledger_balance") @db.Decimal(12, 2)
  note          String?
  countedBy     String   @map("counted_by") @db.Uuid
  countedAt     DateTime @default(now()) @map("counted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, countedAt])
  @@map("petty_cash_counts")
}

// ─── HR & Payroll (admin console + staff mobile; feature flag `hrms`) ─────────
// Money is NUMERIC(12,2) here and integer paise in application code. Sensitive
// identifiers (PAN, Aadhaar, UAN, ESI no., bank details) are AES-256-GCM
// ciphertext ("v1:iv:tag:data", same scheme/key as the payment-gateway secrets);
// the *_hints JSON holds only masked display values.

enum EmploymentType {
  PERMANENT
  CONTRACT
  PART_TIME
  DAILY_WAGE
}

enum EmployeeStatus {
  ACTIVE
  EXITED
}

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkingDaysRule {
  CALENDAR
  FIXED_30
  WORKING_DAYS
}

enum PayRunStatus {
  DRAFT
  REVIEW
  APPROVED
  LOCKED
  CANCELLED
}

enum PayItemKind {
  EARNING
  DEDUCTION
}

enum PayItemSource {
  STRUCTURE
  STATUTORY
  ADJUSTMENT
}

/// Per-school HR and payroll configuration (created with defaults on first use).
/// Statutory values are DEFAULTS to be verified by the school's accountant.
model HrSetting {
  tenantId              String          @id @map("tenant_id") @db.Uuid
  /// 0 = Sunday .. 6 = Saturday
  weeklyOffDays         Int[]           @default([0]) @map("weekly_off_days")
  workingDaysRule       WorkingDaysRule @default(CALENDAR) @map("working_days_rule")
  treatUnmarkedAsAbsent Boolean         @default(false) @map("treat_unmarked_as_absent")
  /// Month (1-12) the leave year starts in; 4 = April.
  leaveYearStartMonth   Int             @default(4) @map("leave_year_start_month")
  pfEnabled             Boolean         @default(true) @map("pf_enabled")
  pfEmployeeRate        Decimal         @default(12) @map("pf_employee_rate") @db.Decimal(5, 2)
  pfEmployerRate        Decimal         @default(12) @map("pf_employer_rate") @db.Decimal(5, 2)
  pfWageCeiling         Decimal         @default(15000) @map("pf_wage_ceiling") @db.Decimal(12, 2)
  esiEnabled            Boolean         @default(true) @map("esi_enabled")
  esiEmployeeRate       Decimal         @default(0.75) @map("esi_employee_rate") @db.Decimal(5, 2)
  esiEmployerRate       Decimal         @default(3.25) @map("esi_employer_rate") @db.Decimal(5, 2)
  esiWageCeiling        Decimal         @default(21000) @map("esi_wage_ceiling") @db.Decimal(12, 2)
  ptEnabled             Boolean         @default(true) @map("pt_enabled")
  /// [{ fromPaise, toPaise|null, monthlyPaise, februaryPaise? }] on monthly gross.
  ptSlabs               Json            @default("[]") @map("pt_slabs")
  slabsSeeded           Boolean         @default(false) @map("slabs_seeded")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("hr_settings")
}

model Employee {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  /// Login account of this person, when they have one (teachers, admin, accounts). Ground staff have none.
  userId         String?        @unique @map("user_id") @db.Uuid
  employeeCode   String         @map("employee_code")
  name           String
  phone          String?
  email          String?
  designation    String
  department     String?
  employmentType EmploymentType @default(PERMANENT) @map("employment_type")
  joinDate       DateTime       @map("join_date") @db.Date
  exitDate       DateTime?      @map("exit_date") @db.Date
  exitReason     String?        @map("exit_reason")
  status         EmployeeStatus @default(ACTIVE)
  panEnc         String?        @map("pan_enc")
  aadhaarEnc     String?        @map("aadhaar_enc")
  uanEnc         String?        @map("uan_enc")
  esiNumberEnc   String?        @map("esi_number_enc")
  bankAccountEnc String?        @map("bank_account_enc")
  bankIfscEnc    String?        @map("bank_ifsc_enc")
  bankHolderEnc  String?        @map("bank_holder_enc")
  /// Masked display values only, e.g. { pan: "XXXXX1234X", bankAccount: "XXXXXX7890" }.
  sensitiveHints Json           @default("{}") @map("sensitive_hints")
  createdBy      String         @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  documents  EmployeeDocument[]
  attendance StaffAttendance[]
  leaves     LeaveRequest[]
  structures SalaryStructure[]
  payLines   PayRunLine[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId, status])
  @@map("employees")
}

model EmployeeDocument {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  /// Free label: Offer letter, ID proof, Contract ...
  label       String
  /// S3 key (private/{tenantId}/hr/{employeeId}/...), never a URL.
  fileKey     String   @map("file_key")
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  size        Int
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@map("employee_documents")
}

/// Shared staff documents: folders any teacher/admin/accounts user of the school
/// can create, and files every staff member of the school can see and download.
model StaffFolder {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  files  StaffFile[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("staff_folders")
}

model StaffFile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  folderId    String   @map("folder_id") @db.Uuid
  /// S3 key (private/{tenantId}/staff-docs/{folderId}/...), never a URL.
  fileKey     String   @map("file_key")
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  size        Int
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folder StaffFolder @relation(fields: [folderId], references: [id], onDelete: Restrict)

  @@index([tenantId, folderId])
  @@map("staff_files")
}

/// One row per employee per day. Rows written by an approved leave carry leaveRequestId.
model StaffAttendance {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  employeeId     String                @map("employee_id") @db.Uuid
  date           DateTime              @db.Date
  status         StaffAttendanceStatus
  note           String?
  leaveRequestId String?               @map("leave_request_id") @db.Uuid
  markedBy       String                @map("marked_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([tenantId, date])
  @@map("staff_attendance")
}

model LeaveType {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  /// Days per leave year (half days allowed).
  yearlyAllowance Decimal  @map("yearly_allowance") @db.Decimal(5, 1)
  /// Most unused days carried into the next leave year.
  carryForwardCap Decimal  @default(0) @map("carry_forward_cap") @db.Decimal(5, 1)
  isPaid          Boolean  @default(true) @map("is_paid")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests LeaveRequest[]

  @@unique([tenantId, name])
  @@map("leave_types")
}

model LeaveRequest {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  employeeId   String             @map("employee_id") @db.Uuid
  leaveTypeId  String             @map("leave_type_id") @db.Uuid
  fromDate     DateTime           @map("from_date") @db.Date
  toDate       DateTime           @map("to_date") @db.Date
  halfDay      Boolean            @default(false) @map("half_day")
  /// Leave days counted (weekly offs and school holidays excluded) when the request was made.
  days         Decimal            @db.Decimal(5, 1)
  reason       String
  status       LeaveRequestStatus @default(PENDING)
  requestedBy  String             @map("requested_by") @db.Uuid
  decidedBy    String?            @map("decided_by") @db.Uuid
  decidedAt    DateTime?          @map("decided_at")
  decisionNote String?            @map("decision_note")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: NoAction)
  leaveType  LeaveType         @relation(fields: [leaveTypeId], references: [id], onDelete: NoAction)
  attendance StaffAttendance[]

  @@index([tenantId, status])
  @@index([employeeId, fromDate])
  @@map("leave_requests")
}

/// Effective-dated and immutable: a change is a new row with a later effective_from.
model SalaryStructure {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Date
  basic         Decimal  @db.Decimal(12, 2)
  /// [{ name, kind: EARNING|DEDUCTION, calc: FIXED|PERCENT_OF_BASIC, amountPaise?, percentBp? }]
  components    Json     @default("[]")
  pfApplicable  Boolean  @default(false) @map("pf_applicable")
  esiApplicable Boolean  @default(false) @map("esi_applicable")
  ptApplicable  Boolean  @default(false) @map("pt_applicable")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction)

  @@unique([employeeId, effectiveFrom])
  @@index([tenantId, employeeId])
  @@map("salary_structures")
}

/// One non-cancelled run per school per month (partial unique index in the migration).
model PayRun {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  /// YYYY-MM
  month            String       @db.VarChar(7)
  status           PayRunStatus @default(DRAFT)
  /// Settings in force when the run was generated, so later changes never rewrite it.
  settingsSnapshot Json         @map("settings_snapshot")
  preparedBy       String       @map("prepared_by") @db.Uuid
  submittedAt      DateTime?    @map("submitted_at")
  approvedBy       String?      @map("approved_by") @db.Uuid
  approvedAt       DateTime?    @map("approved_at")
  selfApproved     Boolean      @default(false) @map("self_approved")
  lockedBy         String?      @map("locked_by") @db.Uuid
  lockedAt         DateTime?    @map("locked_at")
  cancelledBy      String?      @map("cancelled_by") @db.Uuid
  cancelledAt      DateTime?    @map("cancelled_at")
  cancelReason     String?      @map("cancel_reason")
  paidAt           DateTime?    @map("paid_at")
  paidBy           String?      @map("paid_by") @db.Uuid
  paymentReference String?      @map("payment_reference")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  PayRunLine[]

  @@index([tenantId, month])
  @@map("pay_runs")
}

/// Per-employee snapshot: later edits to the employee or structure never change it.
model PayRunLine {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  payRunId        String   @map("pay_run_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  employeeCode    String   @map("employee_code")
  employeeName    String   @map("employee_name")
  designation     String
  department      String?
  /// Salary structure used (null when the employee had none: the line is zero and flagged).
  structureId     String?  @map("structure_id") @db.Uuid
  /// Divisor used for proration (days in month, 30, or working days).
  periodDays      Int      @map("period_days")
  lopDays         Decimal  @default(0) @map("lop_days") @db.Decimal(5, 1)
  paidDays        Decimal  @default(0) @map("paid_days") @db.Decimal(5, 1)
  unmarkedDays    Int      @default(0) @map("unmarked_days")
  grossEarnings   Decimal  @default(0) @map("gross_earnings") @db.Decimal(12, 2)
  totalDeductions Decimal  @default(0) @map("total_deductions") @db.Decimal(12, 2)
  netPay          Decimal  @default(0) @map("net_pay") @db.Decimal(12, 2)
  employerPf      Decimal  @default(0) @map("employer_pf") @db.Decimal(12, 2)
  employerEsi     Decimal  @default(0) @map("employer_esi") @db.Decimal(12, 2)
  /// Warnings found while generating (no structure, unmarked days, missing bank details).
  flags           String[] @default([])
  /// Encrypted bank snapshot used for the transfer file.
  bankAccountEnc  String?  @map("bank_account_enc")
  bankIfscEnc     String?  @map("bank_ifsc_enc")
  bankHolderEnc   String?  @map("bank_holder_enc")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payRun   PayRun           @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: NoAction)
  items    PayRunLineItem[]

  @@unique([payRunId, employeeId])
  @@index([tenantId, employeeId])
  @@map("pay_run_lines")
}

model PayRunLineItem {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  lineId    String        @map("line_id") @db.Uuid
  kind      PayItemKind
  source    PayItemSource
  /// BASIC, PF, ESI, PT, or null for custom components and adjustments.
  code      String?
  name      String
  amount    Decimal       @db.Decimal(12, 2)
  /// Required for adjustments.
  reason    String?
  createdBy String?       @map("created_by") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  line   PayRunLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@map("pay_run_line_items")
}
